{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "herramientas-rentables",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-08-25",
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": false
    }
  }
}
